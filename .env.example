# ---- Supabase (client-safe: embedded in the web app) ----
# Found in Supabase dashboard → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# ---- Supabase (SECRET: worker + server functions only, NEVER in the browser) ----
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Ingestion worker ----
# SEC and polite clients require a real contact in the User-Agent.
SOURCE_USER_AGENT=Squawkwire/0.2 (contact: you@example.com)
# Sentiment backend: keyword (default, no ML deps) or finbert (Phase 2, needs requirements.txt).
SENTIMENT_BACKEND=keyword

# ---- Email alerts (Phase 3, Resend) ----
EMAIL_API_KEY=your-resend-api-key
EMAIL_FROM=Squawkwire <alerts@yourdomain.com>
APP_BASE_URL=https://your-app.vercel.app

# ---- Stripe billing (Phase 4) — SERVER-ONLY, set in Vercel project env, NEVER in web/ ----
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Price ids go in the DB (plans.provider_price_id via migration 0007), not here.

# ---- Reserved for later phases (names only; do not fill yet) ----
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# TELEGRAM_BOT_TOKEN=
# FINNHUB_API_KEY=
# FRED_API_KEY=
# BLS_API_KEY=
# SENTRY_DSN=
